# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App (required)
NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# Production secrets (required in production)
MFA_OTP_SECRET=long-random-string-for-production
GUEST_SESSION_SECRET=long-random-string-for-guest-sessions
CRON_SECRET=long-random-string-for-vercel-cron

# Block new owner self-signup in production (default). Set DISABLE_PUBLIC_SIGNUP=false to allow.
# DISABLE_PUBLIC_SIGNUP=true

# SMS (at least one provider required in production)
# ARKESEL_API_KEY=
# ARKESEL_SENDER_ID=MOJO

# Termii — WhatsApp only (SMS stays on Arkesel; staff can choose SMS or WhatsApp for MFA)
# TERMII_API_KEY=tlv_...   # copy from Termii Overview → API Configuration
# TERMII_BASE_URL=https://v4.api.termii.com
# TERMII_WHATSAPP_SENDER=   # Device ID from Termii (required for WhatsApp)
# TERMII_WHATSAPP_TEMPLATE_ID=  # Approved WhatsApp Authentication/OTP template id (recommended for MFA)
# NOTIFICATION_CHANNELS=sms,whatsapp

# Twilio Verify (optional — email MFA; phone MFA uses Termii WhatsApp when configured)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Email (required in production if SMS not used for all alerts)
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=MOJO Apartments <alerts@yourdomain.com>
# Sandbox (onboarding@resend.dev) only delivers to your Resend account email.
# Verify a domain at resend.com/domains before inviting staff or emailing guests.

# Error monitoring (recommended — create a project at sentry.io)
# SENTRY_DSN=https://...@....ingest.sentry.io/...
# NEXT_PUBLIC_SENTRY_DSN=  # same DSN — required for browser error capture
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=  # Vercel/CI only — uploads source maps at build time

# Content-Security-Policy: set CSP_REPORT_ONLY=true on staging before enforcing in production
# CSP_REPORT_ONLY=true
# CSP_REPORT_URI=https://your-csp-report-endpoint.example.com/csp

# SMS_PROVIDER=arkesel|hubtel|twilio
# NOTIFICATION_CHANNELS=sms

# Guest → hotel online payments (Paystack). Off by default — enable per deployment.
# PAYMENTS_ENABLED=false
# PAYSTACK_SECRET_KEY=sk_test_...   # required when PAYMENTS_ENABLED=true (server only)
# Optional: only if using Paystack Inline JS (v1 uses hosted checkout redirect — leave unset)
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...

# Hikvision access control: device passwords live on the on-site agent only.
# See docs/access-control.md and services/hikvision-agent/
# Access Agent installers (defaults: GitHub Release access-agent-v{VERSION})
# NEXT_PUBLIC_ACCESS_AGENT_VERSION=1.3.7
# NEXT_PUBLIC_ACCESS_AGENT_RELEASE_TAG=access-agent-v1.3.7
# Override individual assets if needed:
# NEXT_PUBLIC_ACCESS_AGENT_MAC_DMG_URL=
# NEXT_PUBLIC_ACCESS_AGENT_WIN_SETUP_URL=
