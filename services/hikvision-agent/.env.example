# Cloud
MOJO_API_URL=https://your-production-domain.com
HOTEL_ID=00000000-0000-0000-0000-000000000000
AGENT_TOKEN=mojo_ac_paste_from_owner_settings

# Optional
AGENT_ID=mojo-front-desk-pc
POLL_INTERVAL_MS=5000
HEARTBEAT_INTERVAL_MS=30000

# Device credentials:
#   cloud = download controllers from MOJO Access (recommended if you want passwords in the app)
#   local = use DEVICES below only
#   auto  = use DEVICES if set, otherwise cloud
DEVICE_SOURCE=cloud

# Only required when DEVICE_SOURCE=local (or auto with local passwords)
# DEVICES=[{"key":"lobby","host":"192.168.1.64","port":80,"username":"admin","password":"CHANGE_ME","useHttps":false}]
